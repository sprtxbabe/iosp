{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iosp://schemas/omega/v0.1.0/omega_feedback.json",
  "title": "Omega Feedback Schema",
  "description": "Defines the structure of risk feedback that omega produces for the entity. Feedback represents the risk trajectory, proximity to risk thresholds, and protective recommendations.",
  "type": "object",
  "required": [
    "feedback_id",
    "schema_version",
    "omega_ref",
    "entity_ref",
    "bridge_ref",
    "timestamp",
    "context_snapshot",
    "risk_analysis",
    "neph_required"
  ],
  "properties": {
    "feedback_id": {
      "type": "string",
      "format": "uri",
      "pattern": "^(iosp|sprtx)://omega-feedback/[a-zA-Z0-9_-]+$",
      "description": "Unique identifier for this feedback instance."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the omega feedback schema specification."
    },
    "omega_ref": {
      "type": "object",
      "description": "Reference to the omega that produced this feedback.",
      "required": ["omega_id"],
      "properties": {
        "omega_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^(iosp|sprtx)://omega/[a-zA-Z0-9_-]+$"
        },
        "computation_version": {
          "type": "string",
          "description": "Version of computation model used to generate this feedback."
        }
      }
    },
    "entity_ref": {
      "type": "object",
      "description": "Reference to the entity this feedback is for.",
      "required": ["entity_id"],
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^(iosp|sprtx)://[a-zA-Z0-9/_-]+$"
        }
      }
    },
    "bridge_ref": {
      "type": "object",
      "description": "Reference to the bridge through which this feedback flows.",
      "required": ["bridge_id"],
      "properties": {
        "bridge_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^(iosp|sprtx)://omega-bridge/[a-zA-Z0-9_-]+$"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this feedback was generated."
    },
    "feedback_type": {
      "type": "string",
      "enum": ["scheduled", "event_triggered", "threshold_triggered", "on_demand", "critical_alert"],
      "description": "What triggered this feedback generation. 'critical_alert' for immediate high-severity risk detection."
    },
    "alert_level": {
      "type": "string",
      "enum": ["routine", "elevated", "warning", "critical"],
      "description": "Overall alert level of this feedback."
    },
    "protocol_context": {
      "type": "object",
      "description": "Protocol namespace for this feedback.",
      "properties": {
        "source_protocol": {
          "type": "string",
          "enum": ["iosp", "sprtx"],
          "description": "Protocol under which feedback was generated."
        },
        "target_protocol": {
          "type": "string",
          "enum": ["iosp", "sprtx"],
          "description": "Protocol under which feedback should be consumed."
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "description": "Snapshot of the context analyzed to produce this risk feedback.",
      "required": ["snapshot_timestamp", "analyzed_dimensions"],
      "properties": {
        "snapshot_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the analyzed state was captured."
        },
        "snapshot_id": {
          "type": "string",
          "description": "Reference to stored state snapshot if applicable."
        },
        "analyzed_dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension_id", "dimension_type"],
            "properties": {
              "dimension_id": { "type": "string" },
              "dimension_type": {
                "type": "string",
                "enum": ["physical", "technical", "tactical", "mental", "recovery", "contextual", "relational", "financial", "operational", "engagement", "developmental", "reputational", "custom"]
              },
              "data_quality": {
                "type": "string",
                "enum": ["complete", "partial", "estimated", "stale"],
                "description": "Quality of data available for this dimension."
              }
            }
          },
          "description": "Dimensions that were analyzed for risk."
        },
        "event_context": {
          "type": "object",
          "description": "If feedback was event-triggered, the triggering event.",
          "properties": {
            "event_type": { "type": "string" },
            "event_timestamp": { "type": "string", "format": "date-time" },
            "event_ref": { "type": "string" }
          }
        },
        "load_context": {
          "type": "object",
          "description": "Training/competition load context for risk assessment.",
          "properties": {
            "acute_load": { "type": "number" },
            "chronic_load": { "type": "number" },
            "load_ratio": { "type": "number" },
            "load_trend": { "type": "string", "enum": ["increasing", "stable", "decreasing"] }
          }
        },
        "environmental_context": {
          "type": "object",
          "description": "External context factors considered.",
          "additionalProperties": true
        }
      }
    },
    "risk_analysis": {
      "type": "object",
      "description": "Analysis of risk trajectory and threshold proximity.",
      "required": ["overall_risk"],
      "properties": {
        "overall_risk": {
          "type": "object",
          "required": ["score", "trajectory"],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall risk score (0 = minimal risk, 1 = maximum risk)."
            },
            "trajectory": {
              "type": "string",
              "enum": ["improving", "stable", "worsening"],
              "description": "Direction of risk movement over time."
            },
            "trajectory_velocity": {
              "type": "number",
              "description": "Rate of risk change."
            },
            "protective_distance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Distance from nearest critical threshold (1 = far/safe, 0 = at threshold)."
            }
          }
        },
        "threshold_proximity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["threshold_id", "threshold_type", "proximity"],
            "properties": {
              "threshold_id": {
                "type": "string",
                "description": "Reference to ORISK threshold definition."
              },
              "threshold_type": {
                "type": "string",
                "enum": [
                  "injury_acute",
                  "injury_chronic",
                  "injury_career_ending",
                  "burnout",
                  "overtraining",
                  "performance_decline",
                  "career_termination",
                  "financial_instability",
                  "reputation_damage",
                  "health_deterioration",
                  "relationship_breakdown",
                  "regulatory_sanction",
                  "talent_exodus",
                  "operational_failure",
                  "engagement_loss",
                  "custom"
                ]
              },
              "proximity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How close to this threshold (0 = far, 1 = at/breached)."
              },
              "breached": {
                "type": "boolean",
                "description": "Whether this threshold has been breached."
              },
              "breach_timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "If breached, when."
              },
              "trend": {
                "type": "string",
                "enum": ["approaching", "stable", "receding"]
              },
              "estimated_time_to_breach": {
                "type": "string",
                "format": "duration",
                "description": "If approaching, estimated time until breach at current trajectory."
              }
            }
          },
          "description": "Proximity to each defined risk threshold."
        },
        "dimension_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension_id", "risk_score"],
            "properties": {
              "dimension_id": {
                "type": "string",
                "description": "Which dimension this risk applies to."
              },
              "dimension_type": {
                "type": "string",
                "enum": ["physical", "technical", "tactical", "mental", "recovery", "contextual", "relational", "financial", "operational", "engagement", "developmental", "reputational", "custom"]
              },
              "risk_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Risk level for this dimension."
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"],
                "description": "Severity classification."
              },
              "risk_factors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "factor_id": { "type": "string" },
                    "factor_description": { "type": "string" },
                    "contribution": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "description": "Specific factors contributing to risk in this dimension."
              },
              "trend": {
                "type": "string",
                "enum": ["improving", "stable", "worsening"]
              },
              "orisk_impact": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How much this dimension contributes to overall ORISK."
              },
              "sub_risks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sub_dimension": { "type": "string" },
                    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "description": "Finer-grained risk breakdown within this dimension."
              }
            }
          }
        },
        "correlation_insights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "insight_id": { "type": "string" },
              "correlated_risks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "insight_description": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "description": "Insights about relationships between risk factors."
        },
        "cluster_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signal_id": { "type": "string" },
              "cluster_ref": { "type": "string" },
              "signal_description": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "description": "Risk signals derived from cluster pattern analysis."
        }
      }
    },
    "recommendations": {
      "type": "object",
      "description": "Protective recommendations based on risk analysis.",
      "properties": {
        "immediate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "description": "Actions to take now (within 24-48 hours) - stop training, see physician, etc."
        },
        "short_term": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "description": "Actions for the near term (days to weeks) - reduce load, increase recovery."
        },
        "structural": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "description": "Fundamental changes to approach (weeks to months) - modify training methodology."
        },
        "strategic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "description": "Long-term risk management (months to years) - career path adjustment."
        },
        "observational": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "description": "Risk indicators to monitor without immediate action required."
        }
      }
    },
    "confidence": {
      "type": "object",
      "description": "Confidence assessment for this feedback.",
      "properties": {
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence in this risk assessment."
        },
        "confidence_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor": { "type": "string" },
              "impact": { "type": "string", "enum": ["positive", "negative"] },
              "description": { "type": "string" }
            }
          },
          "description": "Factors affecting confidence level."
        },
        "data_quality_impact": {
          "type": "string",
          "enum": ["none", "minor", "moderate", "significant"],
          "description": "How data quality issues affected confidence."
        }
      }
    },
    "orisk_projection": {
      "type": "object",
      "description": "Projection of ORISK trajectory.",
      "properties": {
        "current_trajectory": {
          "type": "object",
          "description": "Where entity is heading without changes.",
          "properties": {
            "projected_risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "horizon": {
              "type": "string",
              "format": "duration"
            },
            "threshold_breach_projections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "threshold_id": { "type": "string" },
                  "breach_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                  "estimated_breach_time": { "type": "string", "format": "duration" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "mitigated_trajectory": {
          "type": "object",
          "description": "Where entity could be heading with recommended protective actions.",
          "properties": {
            "projected_risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "horizon": {
              "type": "string",
              "format": "duration"
            },
            "threshold_breach_projections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "threshold_id": { "type": "string" },
                  "breach_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "trajectory_delta": {
          "type": "number",
          "description": "Risk reduction possible with recommended actions."
        }
      }
    },
    "feedback_lineage": {
      "type": "object",
      "description": "Connection to previous feedback for tracking risk evolution.",
      "properties": {
        "previous_feedback_ref": {
          "type": "string",
          "description": "Reference to the previous feedback instance."
        },
        "recommendation_tracking": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recommendation_id": {
                "type": "string",
                "description": "ID of recommendation from previous feedback."
              },
              "status": {
                "type": "string",
                "enum": ["implemented", "partially_implemented", "not_implemented", "no_longer_relevant"]
              },
              "effectiveness": {
                "type": "string",
                "enum": ["highly_effective", "effective", "partially_effective", "ineffective", "unknown"],
                "description": "If implemented, how effective was it at reducing risk."
              }
            }
          },
          "description": "Tracking of previous recommendations."
        },
        "risk_progression": {
          "type": "object",
          "description": "How risk has changed since previous feedback.",
          "properties": {
            "overall_change": {
              "type": "number",
              "description": "Change in overall risk score (positive = increased risk)."
            },
            "dimension_changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimension_id": { "type": "string" },
                  "change": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "delivery_metadata": {
      "type": "object",
      "description": "Metadata about feedback delivery.",
      "properties": {
        "delivery_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "delivery_status": {
          "type": "string",
          "enum": ["pending", "delivered", "acknowledged", "failed"]
        },
        "delivery_attempts": {
          "type": "integer"
        },
        "acknowledgment_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "escalation_status": {
          "type": "string",
          "enum": ["not_escalated", "escalated", "acknowledged_post_escalation"],
          "description": "Whether this feedback triggered escalation to other targets."
        }
      }
    },
    "neph_required": {
      "type": "boolean",
      "const": true,
      "description": "Feedback access requires NEPH authorization. This is always true."
    },
    "neph_context": {
      "type": "object",
      "description": "NEPH authorization context for this feedback.",
      "properties": {
        "authorizing_neph": {
          "type": "string",
          "description": "NEPH ID that authorizes access to this feedback."
        },
        "access_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "What aspects of feedback are accessible under this NEPH."
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extension point for domain-specific or implementation-specific additions."
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "required": ["recommendation_id", "type", "description"],
      "properties": {
        "recommendation_id": {
          "type": "string",
          "description": "Unique identifier for tracking this recommendation."
        },
        "type": {
          "type": "string",
          "enum": ["cease_activity", "reduce_load", "modify_approach", "seek_professional", "monitor", "environmental_change", "relationship_action", "resource_action", "custom"],
          "description": "Classification of risk mitigation recommendation."
        },
        "urgency": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "description": "How urgently this recommendation should be acted upon."
        },
        "target_dimension": {
          "type": "string",
          "description": "Which dimension this recommendation addresses."
        },
        "target_threshold": {
          "type": "string",
          "description": "Which risk threshold this recommendation aims to protect."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the recommendation."
        },
        "rationale": {
          "type": "string",
          "description": "Why this recommendation is being made."
        },
        "expected_impact": {
          "type": "object",
          "properties": {
            "risk_reduction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Expected reduction in risk if implemented."
            },
            "threshold_protection": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Expected increase in protective distance from thresholds."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "effort_estimate": {
          "type": "string",
          "enum": ["minimal", "low", "moderate", "high", "significant"],
          "description": "Estimated effort to implement."
        },
        "opportunity_cost": {
          "type": "object",
          "description": "What the entity gives up by following this recommendation.",
          "properties": {
            "awin_impact": {
              "type": "number",
              "minimum": -1,
              "maximum": 0,
              "description": "Negative impact on AWIN objectives (growth tradeoff)."
            },
            "description": { "type": "string" }
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other recommendations or conditions this depends on."
        },
        "contraindications": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Conditions that would make this recommendation inadvisable."
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": { "type": "string" },
              "metric_name": { "type": "string" },
              "target_value": { "type": ["string", "number"] },
              "measurement_method": { "type": "string" }
            }
          },
          "description": "Metrics to track risk reduction effectiveness."
        },
        "expiration": {
          "type": "string",
          "format": "date-time",
          "description": "When this recommendation expires or should be re-evaluated."
        }
      }
    }
  },
  "additionalProperties": false
}
